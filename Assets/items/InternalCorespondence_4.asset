  m_Script: {fileID: 11500000, guid: 04409aefae9d73241b9cdf59673ff866, type: 3}
  m_Name: InternalCorespondence_4
  m_EditorClassIdentifier: 
  pageNumber: 12
  noteTitle: IC 1/4
  noteContent: "Subject: Immediate Attention \u2013 Kowalski's Experiment. From:
    Dean Jan Nowak To: Head of Security. Body: I am profoundly disturbed. Kowalski's
    experiment is no longer theoretical \u2013 it is a volatile situation! The Dean's
    Access Card is on my desk \u2013 it is intended to grant you access to the control
    panel and the capability for emergency unlocking. If IT escapes his laboratory...
    I dread to consider the consequences. Secure the 1st floor until further notice!"
